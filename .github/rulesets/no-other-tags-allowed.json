{
  "name": "no-other-tags-allowed",
  "target": "tag",
  "source_type": "Repository",
  "source": "jeduden/parleyinn",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "exclude": ["refs/tags/v*.*.*"],
      "include": ["~ALL"]
    }
  },
  "bypass_actors": [],
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    { "type": "creation" },
    { "type": "update" }
  ]
}
